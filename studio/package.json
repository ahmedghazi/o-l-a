  "engines": {
    "node": "22.22.0"
  },
  "dependencies": {
    "@sanity/vision": "6.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-is": "^19.3.1",
    "sanity": "6.22.0",
    "sanity-plugin-media": "^6.6.1",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^8.0.7",
    "@sanity/eslint-config-studio": "^7.0.0",
    "@types/react": "^19.3.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "sanity-codegen": "^0.9.8",
    "typescript": "^7.0.2"
  },
  "prettier": {
